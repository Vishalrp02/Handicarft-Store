{
  "name": "@craftoria/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas: DTOs, internal APIs, events, error codes. Depends only on zod; safe for browsers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./fixtures/*.json": "./fixtures/*.json"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@craftoria/eslint-config": "workspace:*",
    "@craftoria/tsconfig": "workspace:*",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
